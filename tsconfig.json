{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "src/helpers/common.js",
    "src/components/Header.jsx"
, "src/app/_layout.jsx", "src/app/index.jsx", "src/components/ScreenWrapper.jsx"  ]
}
